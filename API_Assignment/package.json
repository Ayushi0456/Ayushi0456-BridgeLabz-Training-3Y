{
  "name": "ajax-assignment",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "json-server": "0.17.4",
    "concurrently": "8.2.2"
  },
  "scripts": {
    "start:q1": "json-server --watch Q1_Live_Search/db.json --port 3001",
    "start:q2": "json-server --watch Q2_Employee_Dashboard/db.json --port 3002",
    "start:q3": "json-server --watch Q3_Task_Manager/db.json --port 3003",
    "start:all": "concurrently \"npm run start:q1\" \"npm run start:q2\" \"npm run start:q3\""
  }
}